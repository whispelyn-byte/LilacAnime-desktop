{
  "name": "lilacanime-desktop",
  "version": "0.5.56",
  "description": "LilacAnime inspired desktop anime library and player",
  "main": "electron/main.cjs",
  "author": "LilacAnime Desktop",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/build-jassub.cjs && node scripts/build-anime4k.cjs",
    "prestart": "npm run vendor",
    "start": "electron .",
    "predev": "npm run vendor",
    "dev": "electron .",
    "predist": "npm run vendor",
    "dist": "electron-builder --win nsis",
    "predist:mac": "npm run vendor",
    "dist:mac": "electron-builder --mac dmg",
    "predist:linux": "npm run vendor",
    "dist:linux": "electron-builder --linux deb",
    "prepack": "npm run vendor",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jassub": "^2.5.16"
  },
  "build": {
    "appId": "com.lilac.anime.desktop",
    "productName": "LilacAnime",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "LilacAnime",
      "target": "nsis",
      "artifactName": "LilacAnime-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "LilacAnime-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "lilacanime",
      "maintainer": "whispelyn-byte <246124296+whispelyn-byte@users.noreply.github.com>",
      "synopsis": "LilacAnime 애니 라이브러리·플레이어",
      "target": "deb"
    },
    "deb": {
      "artifactName": "LilacAnime-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "adm-zip": "^0.6.1",
    "anime4k.js": "1.1.3",
    "cheerio": "^1.1.2",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3"
  }
}
