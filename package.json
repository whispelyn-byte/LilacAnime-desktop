{
  "name": "lilacanime-desktop",
  "version": "0.3.19",
  "description": "LilacAnime inspired desktop anime library and player",
  "main": "electron/main.cjs",
  "author": "LilacAnime Desktop",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/build-jassub.cjs",
    "prestart": "npm run vendor",
    "start": "electron .",
    "predev": "npm run vendor",
    "dev": "electron .",
    "predist": "npm run vendor",
    "dist": "electron-builder --win nsis",
    "prepack": "npm run vendor",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jassub": "^2.5.16"
  },
  "build": {
    "appId": "com.lilac.anime.desktop",
    "productName": "LilacAnime",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "LilacAnime",
      "target": "nsis",
      "artifactName": "LilacAnime-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "cheerio": "^1.1.2",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3"
  }
}
